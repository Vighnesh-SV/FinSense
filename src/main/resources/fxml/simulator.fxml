<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finsense.controller.SimulatorController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="16" styleClass="content-area">
            <padding>
                <Insets top="24" right="28" bottom="28" left="28"/>
            </padding>

            <VBox styleClass="card" spacing="12">
                <Label text="What-if simulator" styleClass="card-title"/>
                <Label text="Explore a possible purchase without writing any records." styleClass="muted"/>
                <HBox spacing="10">
                    <TextField fx:id="productNameField" promptText="Product name"/>
                    <TextField fx:id="priceField" promptText="Price (₹)"/>
                    <ComboBox fx:id="categoryCombo" promptText="Expense category"/>
                    <ComboBox fx:id="necessityCombo"/>
                    <ComboBox fx:id="instalmentsCombo" promptText="Instalments"/>
                    <Button fx:id="simulateButton" text="Simulate" onAction="#onSimulate" styleClass="btn-primary"/>
                </HBox>
                <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>
            </VBox>

            <VBox fx:id="resultCard" styleClass="card" spacing="12" managed="false" visible="false">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Recommendation" styleClass="section-title"/>
                    <Label fx:id="verdictLabel" text="WAIT" styleClass="badge"/>
                    <Label fx:id="scoreLabel" text="0 / 100" styleClass="muted"/>
                </HBox>
                <Label text="12-month savings projection" styleClass="section-title"/>
                <LineChart fx:id="savingsChart" prefHeight="280" animated="false">
                    <xAxis>
                        <NumberAxis label="Month" forceZeroInRange="true"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Savings (₹)" forceZeroInRange="false"/>
                    </yAxis>
                </LineChart>
                <Label text="Goal impact" styleClass="section-title"/>
                <TableView fx:id="goalsTable" prefHeight="160" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="goalNameCol" text="Goal" prefWidth="170"/>
                        <TableColumn fx:id="goalEtaCol" text="ETA without → with purchase" prefWidth="260"/>
                        <TableColumn fx:id="goalDelayCol" text="Delay" prefWidth="180"/>
                        <TableColumn fx:id="goalDeadlineCol" text="Deadline" prefWidth="130"/>
                    </columns>
                    <placeholder>
                        <Label text="No active goals." styleClass="muted"/>
                    </placeholder>
                </TableView>
                <Label text="Commitments ending during the projection" styleClass="section-title"/>
                <TableView fx:id="commitmentTable" prefHeight="140" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="commitmentNameCol" text="Commitment" prefWidth="200"/>
                        <TableColumn fx:id="commitmentEndCol" text="End date / month" prefWidth="220"/>
                        <TableColumn fx:id="commitmentAmountCol" text="Monthly amount released" prefWidth="220"/>
                    </columns>
                    <placeholder>
                        <Label text="No commitments end in the next year." styleClass="muted"/>
                    </placeholder>
                </TableView>
                <Label text="Warnings" styleClass="section-title"/>
                <ListView fx:id="warningsList" prefHeight="80"/>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
