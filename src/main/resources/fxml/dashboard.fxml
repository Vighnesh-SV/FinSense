<?xml version="1.0" encoding="UTF-8"?>

<!-- Dashboard: KPI strip, then two columns (left: spending + recent activity,
     right: things that need attention, goals, quick actions). -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finsense.controller.DashboardController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="24" styleClass="content-area">
            <padding>
                <Insets top="28" right="36" bottom="36" left="36"/>
            </padding>

            <Label fx:id="statusLabel" styleClass="muted" managed="false" visible="false"/>

            <!-- KPI strip -->
            <HBox spacing="16">
                <VBox styleClass="kpi-card, kpi-accent" HBox.hgrow="ALWAYS">
                    <Label text="INCOME THIS MONTH" styleClass="kpi-label"/>
                    <Label fx:id="incomeKpi" text="₹0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="SPENT THIS MONTH" styleClass="kpi-label"/>
                    <Label fx:id="expenseKpi" text="₹0" styleClass="kpi-value"/>
                    <Label fx:id="forecastNote" styleClass="kpi-note"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="DISPOSABLE / MONTH" styleClass="kpi-label"/>
                    <Label fx:id="disposableKpi" text="₹0" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="FREE SAVINGS" styleClass="kpi-label"/>
                    <Label fx:id="savingsKpi" text="₹0" styleClass="kpi-value"/>
                    <Label fx:id="behaviourKpi" styleClass="kpi-note"/>
                </VBox>
            </HBox>

            <HBox spacing="24">
                <!-- Left column -->
                <VBox spacing="24" HBox.hgrow="ALWAYS" minWidth="400">
                    <VBox styleClass="card" spacing="10">
                        <Label text="Where this month's money went" styleClass="card-title"/>
                        <PieChart fx:id="expenseChart" legendVisible="true" labelsVisible="false"
                                  prefHeight="260" minHeight="240"/>
                    </VBox>

                    <VBox styleClass="card" spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Recent transactions" styleClass="card-title" HBox.hgrow="ALWAYS"
                                   maxWidth="Infinity"/>
                            <Button text="See all" onAction="#onTransactions" styleClass="btn-ghost"/>
                        </HBox>
                        <TableView fx:id="transactionTable" prefHeight="262">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="txnDateCol" text="DATE" prefWidth="110"/>
                                <TableColumn fx:id="txnCategoryCol" text="CATEGORY" prefWidth="180"/>
                                <TableColumn fx:id="txnAmountCol" text="AMOUNT" prefWidth="120"/>
                            </columns>
                            <placeholder><Label text="No transactions yet."/></placeholder>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- Right column -->
                <VBox spacing="24" prefWidth="380" minWidth="340">
                    <VBox styleClass="card" spacing="12">
                        <Label text="Needs your attention" styleClass="card-title"/>
                        <VBox fx:id="attentionBox" spacing="10"/>
                    </VBox>

                    <VBox styleClass="card" spacing="14">
                        <Label text="Savings goals" styleClass="card-title"/>
                        <VBox fx:id="goalsBox" spacing="14"/>
                    </VBox>

                    <VBox styleClass="card" spacing="14">
                        <Label text="Recent decisions" styleClass="card-title"/>
                        <TableView fx:id="purchaseTable" prefHeight="210">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="purchaseNameCol" text="ITEM" prefWidth="190"/>
                                <TableColumn fx:id="purchaseVerdictCol" text="VERDICT" prefWidth="100"/>
                            </columns>
                            <placeholder><Label text="Ask the advisor about a purchase."/></placeholder>
                        </TableView>
                        <HBox spacing="10">
                            <Button text="Ask the advisor" onAction="#onPurchase" styleClass="btn-primary"/>
                            <Button text="Insights" onAction="#onInsights" styleClass="btn-secondary"/>
                            <Button text="Profile" onAction="#onProfile" styleClass="btn-ghost"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
