<?xml version="1.0" encoding="UTF-8"?>

<!-- Transactions: monthly totals, filters + table (left), entry form (right). -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finsense.controller.TransactionsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="24" styleClass="content-area">
            <padding>
                <Insets top="28" right="36" bottom="36" left="36"/>
            </padding>

            <HBox spacing="16">
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="INCOME THIS MONTH" styleClass="kpi-label"/>
                    <Label fx:id="incomeTotal" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="EXPENSES THIS MONTH" styleClass="kpi-label"/>
                    <Label fx:id="expenseTotal" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card, kpi-accent" HBox.hgrow="ALWAYS">
                    <Label text="NET" styleClass="kpi-label"/>
                    <Label fx:id="netTotal" text="—" styleClass="kpi-value"/>
                </VBox>
            </HBox>

            <HBox spacing="24">
                <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS" minWidth="420">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="All transactions" styleClass="card-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Export CSV" onAction="#onExport" styleClass="btn-secondary"/>
                    </HBox>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="24"/>
                            <ColumnConstraints percentWidth="24"/>
                            <ColumnConstraints percentWidth="22"/>
                            <ColumnConstraints percentWidth="30"/>
                        </columnConstraints>
                        <DatePicker fx:id="fromDate" promptText="From" maxWidth="Infinity"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <DatePicker fx:id="throughDate" promptText="Through" maxWidth="Infinity"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="filterType" promptText="Any type" maxWidth="Infinity"
                                  GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="filterCategory" promptText="Any category" maxWidth="Infinity"
                                  visibleRowCount="8" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <TextField fx:id="searchField" promptText="Search description or category"
                                   GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="3"/>
                        <Button text="Apply filters" onAction="#onFilter" styleClass="btn-secondary" maxWidth="Infinity"
                                GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </GridPane>

                    <TableView fx:id="transactionTable" prefHeight="440">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="dateCol" text="DATE" prefWidth="108"/>
                            <TableColumn fx:id="typeCol" text="TYPE" prefWidth="82" visible="false"/>
                            <TableColumn fx:id="categoryCol" text="CATEGORY" prefWidth="130"/>
                            <TableColumn fx:id="amountCol" text="AMOUNT" prefWidth="115"/>
                            <TableColumn fx:id="descriptionCol" text="DESCRIPTION" prefWidth="220"/>
                        </columns>
                        <placeholder><Label text="No transactions match these filters."/></placeholder>
                    </TableView>
                </VBox>

                <VBox styleClass="card" spacing="16" prefWidth="320" minWidth="300" maxHeight="-Infinity">
                    <VBox spacing="4">
                        <Label text="Add a transaction" styleClass="card-title"/>
                        <Label text="Select a row in the table to edit or delete it." styleClass="muted" wrapText="true"/>
                    </VBox>
                    <HBox spacing="12">
                        <VBox spacing="6" prefWidth="130">
                            <Label text="Type" styleClass="field-label"/>
                            <ComboBox fx:id="typeField" promptText="Type" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Date" styleClass="field-label"/>
                            <DatePicker fx:id="dateField" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="6">
                        <Label text="Category" styleClass="field-label"/>
                        <ComboBox fx:id="categoryField" promptText="Choose a category" maxWidth="Infinity"
                                  visibleRowCount="8"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Amount (₹)" styleClass="field-label"/>
                        <TextField fx:id="amountField" promptText="e.g. 1,250"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Description (optional)" styleClass="field-label"/>
                        <TextField fx:id="descriptionField" promptText="e.g. Weekly groceries"/>
                    </VBox>
                    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false" wrapText="true"/>
                    <Button fx:id="addButton" text="Add transaction" onAction="#onAdd" styleClass="btn-primary"
                            maxWidth="Infinity"/>
                    <HBox spacing="8">
                        <Button fx:id="updateButton" text="Save changes" onAction="#onUpdate" styleClass="btn-secondary"
                                disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="deleteButton" text="Delete" onAction="#onDelete" styleClass="btn-danger"
                                disable="true"/>
                    </HBox>
                    <Button text="Clear form" onAction="#onClear" styleClass="btn-ghost"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
