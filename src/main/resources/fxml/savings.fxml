<?xml version="1.0" encoding="UTF-8"?>

<!-- Savings goals: goal table (top), then goal form and contributions side by side. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finsense.controller.SavingsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="24" styleClass="content-area">
            <padding>
                <Insets top="28" right="36" bottom="36" left="36"/>
            </padding>

            <VBox styleClass="card" spacing="16">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Your goals" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="freeSavingsLabel" text="Free savings: —" styleClass="tag"/>
                </HBox>
                <TableView fx:id="goalTable" prefHeight="260">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="nameCol" text="GOAL" prefWidth="140"/>
                        <TableColumn fx:id="targetCol" text="TARGET" prefWidth="110"/>
                        <TableColumn fx:id="savedCol" text="SAVED" prefWidth="110"/>
                        <TableColumn fx:id="remainingCol" text="LEFT" prefWidth="110"/>
                        <TableColumn fx:id="progressCol" text="PROGRESS" prefWidth="85"/>
                        <TableColumn fx:id="deadlineCol" text="DEADLINE" prefWidth="110"/>
                        <TableColumn fx:id="priorityCol" text="PRIORITY" prefWidth="85"/>
                        <TableColumn fx:id="statusCol" text="STATUS" prefWidth="95"/>
                        <TableColumn fx:id="monthlyCol" text="NEEDED / MONTH" prefWidth="130"/>
                    </columns>
                    <placeholder><Label text="No savings goals yet - create one below."/></placeholder>
                </TableView>
            </VBox>

            <HBox spacing="24">
                <VBox styleClass="card" spacing="16" prefWidth="380" minWidth="330" maxHeight="-Infinity">
                    <VBox spacing="4">
                        <Label text="Goal details" styleClass="card-title"/>
                        <Label text="Select a goal above to change or cancel it." styleClass="muted" wrapText="true"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Name" styleClass="field-label"/>
                        <TextField fx:id="nameField" promptText="e.g. Goa trip"/>
                    </VBox>
                    <VBox spacing="6">
                        <Label text="Target amount (₹)" styleClass="field-label"/>
                        <TextField fx:id="targetField" promptText="e.g. 40,000"/>
                    </VBox>
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Deadline" styleClass="field-label"/>
                            <DatePicker fx:id="deadlinePicker" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Priority" styleClass="field-label"/>
                            <ComboBox fx:id="priorityCombo" promptText="Priority" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Button text="Create goal" onAction="#onCreate" styleClass="btn-primary" maxWidth="Infinity"/>
                    <HBox spacing="8">
                        <Button fx:id="updateButton" text="Save changes" onAction="#onUpdate" styleClass="btn-secondary"
                                disable="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="cancelButton" text="Cancel goal" onAction="#onCancel" styleClass="btn-danger"
                                disable="true"/>
                    </HBox>
                    <Button text="Clear form" onAction="#onClear" styleClass="btn-ghost"/>
                </VBox>

                <VBox styleClass="card" spacing="16" HBox.hgrow="ALWAYS" maxHeight="-Infinity">
                    <VBox spacing="4">
                        <Label text="Put money aside" styleClass="card-title"/>
                        <Label text="Moves money from free savings into the selected goal." styleClass="muted"
                               wrapText="true"/>
                    </VBox>
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Amount (₹)" styleClass="field-label"/>
                            <TextField fx:id="contributionAmountField" promptText="e.g. 5,000"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Date" styleClass="field-label"/>
                            <DatePicker fx:id="contributionDatePicker" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Note (optional)" styleClass="field-label"/>
                            <TextField fx:id="contributionNoteField" promptText="e.g. Bonus"/>
                        </VBox>
                        <Button fx:id="contributeButton" text="Add contribution" onAction="#onContribute"
                                styleClass="btn-primary" disable="true"/>
                    </HBox>
                    <TableView fx:id="contributionTable" prefHeight="200">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="contributionDateCol" text="DATE" prefWidth="120"/>
                            <TableColumn fx:id="contributionAmountCol" text="AMOUNT" prefWidth="120"/>
                            <TableColumn fx:id="contributionNoteCol" text="NOTE" prefWidth="200"/>
                        </columns>
                        <placeholder><Label text="Select a goal to see its contributions."/></placeholder>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
