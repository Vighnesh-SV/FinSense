<?xml version="1.0" encoding="UTF-8"?>

<!-- Insights: trend chart, split of spending, next-month forecast, unusual spending,
     suggestions and behaviour history. The monthly report is exported from here. -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.finsense.controller.InsightsController"
            fitToWidth="true"
            styleClass="content-scroll">
    <content>
        <VBox spacing="24" styleClass="content-area">
            <padding>
                <Insets top="28" right="36" bottom="36" left="36"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="statusLabel" styleClass="muted" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="exportButton" text="Export monthly report" onAction="#onExportReport"
                        styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="16">
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="ESSENTIAL THIS MONTH" styleClass="kpi-label"/>
                    <Label fx:id="essentialValue" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="DISCRETIONARY THIS MONTH" styleClass="kpi-label"/>
                    <Label fx:id="discretionaryValue" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS">
                    <Label text="SAVINGS RATE" styleClass="kpi-label"/>
                    <Label fx:id="savingsRateValue" text="—" styleClass="kpi-value"/>
                </VBox>
                <VBox styleClass="kpi-card, kpi-accent" HBox.hgrow="ALWAYS">
                    <Label text="FORECAST NEXT MONTH" styleClass="kpi-label"/>
                    <Label fx:id="forecastValue" text="—" styleClass="kpi-value"/>
                </VBox>
            </HBox>

            <VBox styleClass="card" spacing="10">
                <Label text="Income and expenses, last six months" styleClass="card-title"/>
                <BarChart fx:id="comparisonChart" prefHeight="300" animated="false" barGap="3" categoryGap="22">
                    <xAxis><CategoryAxis/></xAxis>
                    <yAxis><NumberAxis forceZeroInRange="true"/></yAxis>
                </BarChart>
            </VBox>

            <HBox spacing="24">
                <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS" minWidth="420">
                    <VBox spacing="4">
                        <Label text="Next month, by category" styleClass="card-title"/>
                        <Label text="A straight-line trend over up to six complete months; an average when there are fewer than three."
                               styleClass="muted" wrapText="true"/>
                    </VBox>
                    <TableView fx:id="forecastTable" prefHeight="260">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="forecastCategoryCol" text="CATEGORY" prefWidth="170"/>
                            <TableColumn fx:id="forecastLastCol" text="LAST MONTH" prefWidth="120"/>
                            <TableColumn fx:id="forecastNextCol" text="FORECAST" prefWidth="120"/>
                            <TableColumn fx:id="forecastChangeCol" text="CHANGE" prefWidth="90"/>
                        </columns>
                        <placeholder><Label text="Needs at least one complete month of spending."/></placeholder>
                    </TableView>
                </VBox>

                <VBox styleClass="card" spacing="14" prefWidth="380" minWidth="320">
                    <VBox spacing="4">
                        <Label text="Unusual spending" styleClass="card-title"/>
                        <Label text="Expenses in the last 60 days far above what you normally spend in that category."
                               styleClass="muted" wrapText="true"/>
                    </VBox>
                    <VBox fx:id="anomalyBox" spacing="10"/>
                </VBox>
            </HBox>

            <VBox styleClass="card" spacing="14">
                <Label text="Top categories this month" styleClass="card-title"/>
                <TableView fx:id="categoriesTable" prefHeight="230">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="categoryNameCol" text="CATEGORY" prefWidth="200"/>
                        <TableColumn fx:id="currentSpendCol" text="THIS MONTH" prefWidth="140"/>
                        <TableColumn fx:id="priorSpendCol" text="LAST MONTH" prefWidth="140"/>
                        <TableColumn fx:id="changeCol" text="CHANGE" prefWidth="100"/>
                        <TableColumn fx:id="natureCol" text="TYPE" prefWidth="140"/>
                    </columns>
                    <placeholder><Label text="No spending recorded this month."/></placeholder>
                </TableView>
            </VBox>

            <VBox styleClass="card" spacing="12">
                <Label text="Suggestions" styleClass="card-title"/>
                <VBox fx:id="suggestionsBox" spacing="8"/>
            </VBox>

            <VBox styleClass="card" spacing="14">
                <Label text="How your spending personality changed" styleClass="card-title"/>
                <TableView fx:id="behaviourTable" prefHeight="210">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="behaviourDateCol" text="WHEN" prefWidth="160"/>
                        <TableColumn fx:id="behaviourTypeCol" text="PERSONALITY" prefWidth="160"/>
                        <TableColumn fx:id="behaviourSourceCol" text="SOURCE" prefWidth="130"/>
                        <TableColumn fx:id="behaviourReasonCol" text="REASON" prefWidth="380"/>
                    </columns>
                    <placeholder><Label text="Complete the questionnaire to start tracking."/></placeholder>
                </TableView>
            </VBox>
        </VBox>
    </content>
</ScrollPane>
